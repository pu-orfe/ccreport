# Runtime environment; wrong values can enable development-only behavior or confusing logs.
CCREPORT_ENVIRONMENT=development
# Log level; wrong values hide useful diagnostics or create noisy logs.
CCREPORT_LOG_LEVEL=INFO
# Public base URL used for OAuth redirects; wrong values break sign-in callbacks.
CCREPORT_BASE_URL=http://localhost:8000
# How many months are selectable; out-of-range values are rejected at startup.
CCREPORT_MONTH_WINDOW=8
# Required email domain after Easy Auth; wrong values lock out valid Princeton users or allow the wrong domain.
CCREPORT_REQUIRED_EMAIL_DOMAIN=princeton.edu
# Comma-separated users allowed into the app. EMPTY MEANS DENY ALL, even when Easy Auth succeeds.
CCREPORT_ALLOWED_PRINCIPALS=
# Comma-separated admins; entries must also be allowed or admin access will not seed correctly.
CCREPORT_ADMIN_PRINCIPALS=
# Local-only Easy Auth bypass principal; setting this on Azure makes the app refuse to boot.
CCREPORT_DEV_PRINCIPAL=
# SQLAlchemy database URL; wrong values prevent migrations and app startup.
CCREPORT_DATABASE_URL=postgresql+psycopg://ccreport:change-me@localhost:5432/ccreport
# Azure Blob account URL; empty writes artifacts locally, wrong values break bundle storage.
CCREPORT_BLOB_ACCOUNT_URL=
# Blob container for report artifacts; wrong values make downloads or uploads fail.
CCREPORT_BLOB_CONTAINER=ccreport-artifacts
# Local artifact directory for development; wrong values may write files somewhere unexpected.
CCREPORT_LOCAL_ARTIFACT_DIR=.ccreport/artifacts
# Azure Key Vault URL for token wrapping; wrong values make stored mailbox credentials unreadable.
CCREPORT_KEYVAULT_URL=
# Key Vault key used to wrap per-record keys; wrong values prevent credential encryption/decryption.
CCREPORT_KEYVAULT_KEY_NAME=ccreport-token-dek
# Development-only encryption key; setting this on Azure makes the app refuse to boot.
CCREPORT_DEV_ENCRYPTION_KEY=
# Secret for OAuth state/session signing; wrong or rotated values invalidate active sessions.
CCREPORT_SESSION_SECRET=change-me-64-random-hex
# In-memory mail header cache TTL; too high retains browsing metadata longer than intended.
CCREPORT_HEADER_CACHE_TTL_SECONDS=600
# In-memory mail header cache size; too low causes excess provider calls, too high uses memory.
CCREPORT_HEADER_CACHE_MAX_ENTRIES=256
# Microsoft OAuth client id; wrong values break Microsoft Graph mailbox connections.
CCREPORT_MS_CLIENT_ID=
# Microsoft OAuth client secret; wrong values break Microsoft Graph token exchange.
CCREPORT_MS_CLIENT_SECRET=
# Microsoft authority URL; wrong tenant values reject intended accounts.
CCREPORT_MS_AUTHORITY=https://login.microsoftonline.com/common
# Microsoft Graph scopes; wrong scopes may over-request access or make receipt browsing impossible.
CCREPORT_MS_SCOPES=offline_access User.Read Mail.Read
# Google OAuth client id; wrong values break Google Workspace Gmail connections.
CCREPORT_GOOGLE_CLIENT_ID=
# Google OAuth client secret; wrong values break Google token exchange.
CCREPORT_GOOGLE_CLIENT_SECRET=
# Google Gmail scopes; wrong scopes may over-request access or make receipt browsing impossible.
CCREPORT_GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly
# Google hosted-domain hint; wrong values confuse Workspace consent but do not enforce access.
CCREPORT_GOOGLE_HOSTED_DOMAIN=princeton.edu
# Google OAuth posture: internal, trusted, verified, testing, or unknown; wrong values can hide 7-day refresh-token expiry.
CCREPORT_GOOGLE_OAUTH_PUBLISHING_STATUS=unknown
# Personal Gmail OAuth requires a fully verified client. Keep false unless Google verification/CASA is complete.
CCREPORT_ENABLE_PERSONAL_GMAIL_OAUTH=false
# IMAP app-password connector toggle; wrong values remove the supported personal Gmail path.
CCREPORT_ENABLE_IMAP=true
# Default IMAP host; wrong values break personal Gmail app-password connections.
CCREPORT_IMAP_DEFAULT_HOST=imap.gmail.com
# Default IMAP port; wrong values break personal Gmail app-password connections.
CCREPORT_IMAP_DEFAULT_PORT=993
# Playwright fallback renderer toggle; false removes the Chromium fallback for difficult layouts.
CCREPORT_ENABLE_PLAYWRIGHT_FALLBACK=true
# Remote-image rendering toggle; true can leak read receipts and break offline rendering.
CCREPORT_ALLOW_REMOTE_IMAGES=false
# Maximum attachment size in MB; wrong values reject valid receipts or allow excessive memory use.
CCREPORT_MAX_ATTACHMENT_MB=25
